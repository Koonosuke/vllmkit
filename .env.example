# =====================================================================
# vllmkit 設定ファイル
#   cp .env.example .env してから編集してください。
#   .env は .gitignore 済みです。Token 等を .env.example に書かないこと。
#   値にスペースを含む場合は "..." で囲んでください。
# =====================================================================

# ---------------------------------------------------------------------
# Compose project / Container 名
#   共有サーバーで複数人が clone する場合は、必ず自分固有の名前に変更する。
#   例: vllmkit-tanaka
# ---------------------------------------------------------------------
COMPOSE_PROJECT_NAME=vllmkit
CONTAINER_NAME=vllmkit-vllm

# ---------------------------------------------------------------------
# Docker Image
#   GX10 (GB10 / ARM64 / sm_121) では NVIDIA NGC の vLLM Container を推奨。
#   本番・研究室共通環境では latest を避け、tag を固定すること。
#   新しい tag は https://catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm で確認。
#   代替: vllm/vllm-openai:<version>  (arm64 / GB10 対応状況を要確認)
# ---------------------------------------------------------------------
VLLM_IMAGE=nvcr.io/nvidia/vllm:25.11-py3

# setup.sh で「Docker Container から GPU が見えるか」を確認するための軽量 Image
CUDA_TEST_IMAGE=nvcr.io/nvidia/cuda:13.0.0-base-ubuntu24.04

# ---------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------
# Hugging Face の Model ID
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# API 上の model 名 (/v1/models に表示される名前。client はこの名前で指定する)
SERVED_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# ---------------------------------------------------------------------
# Memory / Context
#   GX10 は CPU と GPU が同じ 128GB 級の Unified Memory を共有する。
#   0.30 = 全メモリの約 30% を vLLM が確保する (他ユーザー / OS と取り合いになる)。
#   小型 Qwen なら 0.20〜0.30 で十分。大きくする前に free -h で空きを確認すること。
# ---------------------------------------------------------------------
GPU_MEMORY_UTILIZATION=0.30
MAX_MODEL_LEN=8192

# Container の /dev/shm サイズ (ipc: host の代わりに使用)
SHM_SIZE=8g

# ---------------------------------------------------------------------
# Network
#   Host 側は 127.0.0.1 固定 (docker-compose.yml)。ここでは Port 番号のみ変更可。
#   同じサーバーで他の人が 8000 を使っている場合は 8001 などに変更。
# ---------------------------------------------------------------------
HOST_PORT=8000

# ---------------------------------------------------------------------
# Cache (Host 側の保存先。Container を削除しても残る)
#   相対パスはこのリポジトリからの相対。
# ---------------------------------------------------------------------
HF_CACHE_DIR=./cache/huggingface
VLLM_CACHE_DIR=./cache/vllm

# ---------------------------------------------------------------------
# Secrets (絶対に commit しない)
# ---------------------------------------------------------------------
# gated model (Llama 等) を使う場合のみ設定。Qwen2.5 は不要。
HF_TOKEN=
# 設定すると API 呼び出しに "Authorization: Bearer <key>" が必要になる。
# 127.0.0.1 bind でも同じサーバーの他ユーザーからはアクセスできるため、設定推奨。
VLLM_API_KEY=

# ---------------------------------------------------------------------
# その他
# ---------------------------------------------------------------------
# no / on-failure:3 / unless-stopped / always
RESTART_POLICY=unless-stopped

# vLLM に追加で渡す引数 (例: "--dtype bfloat16 --max-num-seqs 16")
VLLM_EXTRA_ARGS=

# start.sh が /health を待つ最大秒数 (初回は Model download があるので長め)
START_TIMEOUT=900
